{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SkeinRank/claim-plane/experiments/cooperbench/schemas/arm-result.schema.json",
  "title": "Claim Plane CooperBench Arm Result Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "pair_key",
    "arm",
    "coder_seed",
    "status",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "pair_key": {"type": "string", "minLength": 1},
    "arm": {
      "enum": [
        "parallel",
        "claim-plane-static",
        "claim-plane-dynamic",
        "always-serial"
      ]
    },
    "coder_seed": {"type": "integer"},
    "status": {"enum": ["completed", "failed", "blocked", "skipped"]},
    "metrics": {"type": "object"},
    "failure": {"type": ["object", "null"]},
    "artifacts": {"type": "object"}
  }
}
