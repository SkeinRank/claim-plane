{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/scip-ablation-physical-benchmark-v3.schema.json",
  "title": "Claim Plane SCIP Ablation and Physical Parallel Benchmark v3",
  "type": "object",
  "required": [
    "protocol",
    "study_id",
    "study_fingerprint",
    "seeds",
    "pair_indexes",
    "profiles",
    "complete",
    "profile_summary",
    "paired_speedup_vs_serial",
    "result_revision",
    "speedup_exclusions",
    "legacy_artifact_units",
    "execution_environment_count",
    "execution_environments",
    "aggregation_environment"
  ],
  "properties": {
    "protocol": {
      "const": "claim-plane.scip-ablation-physical-benchmark.v3"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "study_fingerprint": {
      "type": "string",
      "minLength": 12
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pair_indexes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "serial",
          "naive_parallel",
          "builtin_graph",
          "scip_graph_cold",
          "scip_cache_blocking"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "expected_pair_units": {
      "type": "integer",
      "minimum": 0
    },
    "completed_pair_units": {
      "type": "integer",
      "minimum": 0
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    },
    "observed_rows": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "boolean"
    },
    "missing_pair_units": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile",
          "observations",
          "execution_outcome_counts",
          "excluded_timing_observations",
          "timing_observations",
          "pair_pass_rate",
          "integration_success_rate",
          "serialization_rate",
          "physical_concurrency_rate",
          "mean_active_agents",
          "mean_critical_path_seconds",
          "mean_execution_wall_time_seconds",
          "mean_control_plane_wall_time_seconds",
          "mean_end_to_end_wall_time_seconds"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "observations": {
            "type": "integer",
            "minimum": 0
          },
          "timing_observations": {
            "type": "integer",
            "minimum": 0
          },
          "excluded_timing_observations": {
            "type": "integer",
            "minimum": 0
          },
          "execution_outcome_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "additionalProperties": true
      }
    },
    "paired_speedup_vs_serial": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "paired_observations",
          "valid_speedup_observations",
          "excluded_speedup_observations",
          "exclusion_reasons",
          "mean_execution_speedup_vs_serial",
          "median_execution_speedup_vs_serial",
          "mean_end_to_end_speedup_vs_serial",
          "median_end_to_end_speedup_vs_serial"
        ],
        "properties": {
          "paired_observations": {
            "type": "integer",
            "minimum": 0
          },
          "valid_speedup_observations": {
            "type": "integer",
            "minimum": 0
          },
          "excluded_speedup_observations": {
            "type": "integer",
            "minimum": 0
          },
          "exclusion_reasons": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "mean_execution_speedup_vs_serial": {
            "type": [
              "number",
              "null"
            ]
          },
          "median_execution_speedup_vs_serial": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_end_to_end_speedup_vs_serial": {
            "type": [
              "number",
              "null"
            ]
          },
          "median_end_to_end_speedup_vs_serial": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "speedup_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile",
          "coder_seed",
          "pair_index",
          "reason"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "coder_seed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "pair_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "result_revision": {
      "const": 2
    },
    "legacy_artifact_units": {
      "type": "integer",
      "minimum": 0
    },
    "execution_environment_count": {
      "type": "integer",
      "minimum": 0
    },
    "execution_environments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "aggregation_environment": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
