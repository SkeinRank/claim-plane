{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SkeinRank/claim-plane/experiments/cooperbench/schemas/study.schema.json",
  "title": "Claim Plane CooperBench Study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "description",
    "claim_plane_version",
    "planner_policy_version",
    "planner_model",
    "coder_model",
    "coder_seeds",
    "arms",
    "pairs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {"type": "string", "minLength": 1},
    "claim_plane_version": {"type": "string", "minLength": 1},
    "planner_policy_version": {"type": "string", "minLength": 1},
    "planner_model": {"type": "string", "minLength": 1},
    "coder_model": {"type": "string", "minLength": 1},
    "pair_selection_seed": {"type": ["integer", "null"]},
    "coder_seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "parallel",
          "claim-plane-static",
          "claim-plane-dynamic",
          "always-serial"
        ]
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pair"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "task_id", "feature_a", "feature_b"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "task_id": {"type": "integer", "minimum": 0},
        "feature_a": {"type": "integer", "minimum": 0},
        "feature_b": {"type": "integer", "minimum": 0},
        "gold_conflict": {"type": ["boolean", "null"]}
      }
    }
  }
}
