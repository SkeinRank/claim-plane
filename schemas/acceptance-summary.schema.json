{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/acceptance-summary.schema.json",
  "title": "Claim Plane acceptance summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "commands",
    "command_count",
    "passed",
    "errors",
    "warnings"
  ],
  "properties": {
    "protocol": {
      "const": "claim-plane.acceptance-summary.v1"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command_count": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "boolean"
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "log_dir": {
      "type": [
        "string",
        "null"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "returncode",
          "passed",
          "duration_ms",
          "stdout_tail",
          "stderr_tail"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "returncode": {
            "type": "integer"
          },
          "passed": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "stdout_tail": {
            "type": "string"
          },
          "stderr_tail": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "log_dir": {
            "type": "string"
          }
        }
      }
    }
  }
}
