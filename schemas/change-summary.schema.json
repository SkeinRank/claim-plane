{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/change-summary.schema.json",
  "title": "Claim Plane final change summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "available",
    "base_commit",
    "result_commit",
    "file_count",
    "total_additions",
    "total_deletions",
    "total_hunks",
    "files",
    "digest"
  ],
  "properties": {
    "protocol": {"const": "claim-plane.change-summary.v1"},
    "available": {"const": true},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "result_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "file_count": {"type": "integer", "minimum": 0},
    "total_additions": {"type": "integer", "minimum": 0},
    "total_deletions": {"type": "integer", "minimum": 0},
    "total_hunks": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "additions", "deletions", "binary", "patch_sha256", "hunks"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1, "maxLength": 2},
          "additions": {"type": ["integer", "null"], "minimum": 0},
          "deletions": {"type": ["integer", "null"], "minimum": 0},
          "binary": {"type": "boolean"},
          "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["old_start", "old_lines", "new_start", "new_lines"],
              "properties": {
                "old_start": {"type": "integer", "minimum": 0},
                "old_lines": {"type": "integer", "minimum": 0},
                "new_start": {"type": "integer", "minimum": 0},
                "new_lines": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
