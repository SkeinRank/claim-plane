{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/codex-intent-proposal.schema.json",
  "title": "Claim Plane Codex Intent Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "goal",
    "operations"
  ],
  "properties": {
    "protocol": {
      "const": "claim-plane.codex-intent-proposal.v1"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "change-intent.schema.json#/$defs/operation"
      }
    },
    "preserves": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    }
  }
}
