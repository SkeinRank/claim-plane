{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/codex-scope-amendment.schema.json",
  "title": "Claim Plane Codex Scope Amendment",
  "type": "object",
  "required": [
    "protocol",
    "ticket_id",
    "intent_id",
    "intent_fingerprint",
    "base_commit",
    "request_signature",
    "mutations",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "protocol": {
      "const": "claim-plane.codex-scope-amendment.v1"
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "request_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["access", "path", "target_path"],
        "properties": {
          "access": {
            "enum": ["write", "delete", "rename"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "target_path": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
