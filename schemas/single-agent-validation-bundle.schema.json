{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/single-agent-validation-bundle.schema.json",
  "title": "Claim Plane Single-Agent Validation Bundle",
  "type": "object",
  "required": ["protocol", "created_at", "root_state_digest", "summary_digest", "gate_digest", "files", "digest"],
  "properties": {
    "protocol": {"const": "claim-plane.single-agent-validation-bundle.v1"},
    "created_at": {"type": "string"},
    "root_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
