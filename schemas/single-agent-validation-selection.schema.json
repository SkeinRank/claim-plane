{
  "$id": "https://skeinrank.github.io/claim-plane/schemas/single-agent-validation-selection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "languages": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "profile": {
      "enum": [
        "preview",
        "release"
      ]
    },
    "protocol": {
      "const": "claim-plane.single-agent-validation-selection.v1"
    },
    "repository_count": {
      "minimum": 1,
      "type": "integer"
    },
    "repository_family_count": {
      "minimum": 1,
      "type": "integer"
    },
    "selection_seed": {
      "type": "integer"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url",
        "revision"
      ],
      "type": "object"
    },
    "task_count": {
      "minimum": 1,
      "type": "integer"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "base_commit": {
            "pattern": "^[0-9a-f]{7,64}$",
            "type": "string"
          },
          "clone_url": {
            "minLength": 1,
            "type": "string"
          },
          "cooperbench_task": {
            "minimum": 0,
            "type": "integer"
          },
          "feature": {
            "minimum": 1,
            "type": "integer"
          },
          "gold_paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "initial_scope": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "language": {
            "minLength": 1,
            "type": "string"
          },
          "prompt": {
            "minLength": 1,
            "type": "string"
          },
          "prompt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "repository_family": {
            "minLength": 1,
            "type": "string"
          },
          "repository_id": {
            "minLength": 1,
            "type": "string"
          },
          "risk_class": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "source_ref": {
            "minLength": 1,
            "type": "string"
          },
          "task_class": {
            "minLength": 1,
            "type": "string"
          },
          "task_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "repository_id",
          "repository_family",
          "cooperbench_task",
          "feature",
          "source_ref",
          "clone_url",
          "base_commit",
          "language",
          "prompt",
          "prompt_sha256",
          "gold_paths",
          "initial_scope",
          "task_class",
          "risk_class"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "protocol",
    "source",
    "profile",
    "languages",
    "selection_seed",
    "task_count",
    "repository_count",
    "repository_family_count",
    "tasks",
    "digest"
  ],
  "title": "Claim Plane Single-Agent Validation Selection",
  "type": "object"
}
