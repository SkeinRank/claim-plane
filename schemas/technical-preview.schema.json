{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/technical-preview.schema.json",
  "title": "Claim Plane technical-preview manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "channel", "version", "python", "platform", "stable_commands", "exit_codes", "schemas", "documentation", "limitations"],
  "properties": {
    "protocol": {"const": "claim-plane.technical-preview.v1"},
    "channel": {"const": "single-agent-codex"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "implementation", "supported", "requires"],
      "properties": {
        "version": {"type": "string"},
        "implementation": {"type": "string"},
        "supported": {"type": "boolean"},
        "requires": {"const": ">=3.10"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "machine"],
      "properties": {
        "system": {"type": "string"},
        "machine": {"type": "string"}
      }
    },
    "stable_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exit_codes": {"$ref": "exit-codes.schema.json"},
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "digest_entries"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "digest_entries": {"type": "array", "items": {"$ref": "schema-index.schema.json#/$defs/schema"}}
      }
    },
    "documentation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "present"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "present": {"type": ["boolean", "null"]}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
