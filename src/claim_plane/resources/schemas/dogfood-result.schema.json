{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skeinrank.github.io/claim-plane/schemas/dogfood-result.schema.json",
  "title": "Claim Plane dogfood result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "execution_id", "plan_digest", "suite_digest", "task_id", "repository_id", "seed", "arm", "outcome", "evaluation_complete", "task_success", "accepted_delivery", "undeclared_mutations", "scope_amendments", "false_blocks", "missed_mutations", "human_repairs", "retries", "wall_time_seconds", "input_tokens", "output_tokens", "cost_usd", "files_changed", "lines_added", "lines_deleted", "public_api_drift", "dependency_drift", "evidence_digest"],
  "properties": {
    "protocol": {"const": "claim-plane.dogfood-result.v1"},
    "execution_id": {"type": "string", "pattern": "^dogfood-[0-9a-f]{24}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "suite_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "arm": {"enum": ["bare-codex", "claim-plane-observe", "claim-plane-guarded"]},
    "outcome": {"type": "string", "minLength": 1},
    "evaluation_complete": {"type": "boolean"},
    "task_success": {"type": "boolean"},
    "accepted_delivery": {"type": "boolean"},
    "undeclared_mutations": {"type": "integer", "minimum": 0},
    "scope_amendments": {"type": "integer", "minimum": 0},
    "false_blocks": {"type": "integer", "minimum": 0},
    "missed_mutations": {"type": "integer", "minimum": 0},
    "human_repairs": {"type": "integer", "minimum": 0},
    "retries": {"type": "integer", "minimum": 0},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "files_changed": {"type": "integer", "minimum": 0},
    "lines_added": {"type": "integer", "minimum": 0},
    "lines_deleted": {"type": "integer", "minimum": 0},
    "public_api_drift": {"type": "boolean"},
    "dependency_drift": {"type": "boolean"},
    "evidence_digest": {"type": ["string", "null"]}
  }
}
